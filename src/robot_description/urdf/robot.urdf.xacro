<?xml version="1.0"?>

<robot 
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    name="virtual_mobile_robot">

    <!-- Base -->
    <xacro:property name="base_length" value="0.5" />
    <xacro:property name="base_width" value="0.3" />
    <xacro:property name="base_height" value="0.15" />

    <!-- Wheels -->
    <xacro:property name="wheel_radius" value="0.08" />
    <xacro:property name="wheel_width" value="0.04" />
    <xacro:property name="wheel_separation" value="0.34" />
    <xacro:property name="wheel_x_offset" value="0.0" />

    <!-- Lidar -->
    <xacro:property name="lidar_radius" value="0.05" />
    <xacro:property name="lidar_height" value="0.04" />
    <xacro:property name="lidar_x_offset" value="0.15" />
    <xacro:property name="lidar_z_offset" value="0.25" />

    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 ${wheel_radius + base_height / 2.0}" rpy="0.0 0.0 0.0"/>

            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>

            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <xacro:macro name="wheel" params="name y_position">
        <link name="${name}_wheel_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black">
                    <color rgba="0.05 0.05 0.05 1.0"/>
                </material>
            </visual>
        </link>

        <joint name="${name}_wheel_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${name}_wheel_link"/>
            
            <origin xyz="${wheel_x_offset} ${y_position} ${wheel_radius}" rpy="0.0 0.0 0.0"/>
        </joint>
    </xacro:macro>

    <xacro:wheel name="left" y_position="${wheel_separation / 2.0}"/>
    <xacro:wheel name="right" y_position="${-wheel_separation / 2.0}"/>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/> 
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.3 0.9 1.0"/>
            </material>
        </visual>
    </link>
    
    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_frame"/>
        <origin xyz="${lidar_x_offset} 0 ${lidar_z_offset}" rpy="0.0 0.0 0.0"/>
    </joint>
</robot>