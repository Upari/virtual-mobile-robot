<?xml version="1.0"?>

<sdf version="1.9">

    <world name="lidar_world">

        <!-- Physics simulation -->
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>

        <!-- Allows spawning, moving and deleting entities -->
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>

        <!-- Sends scene information to Gazebo GUI -->
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <!-- Required for GPU lidar and camera sensors -->
        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">

            <render_engine>ogre2</render_engine>
        </plugin>

        <!-- Physics settings -->
        <physics name="physics" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <!-- Directional light -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>

            <pose>0 0 10 0 0 0</pose>

            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>

            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>

            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Ground plane -->
        <model name="ground_plane">
            <static>true</static>

            <link name="link">

                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>

                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                    </material>
                </visual>

            </link>
        </model>

        <!-- ============ 房间 A（北边） y∈[1,4] ============ -->
        <!-- A 北墙（保留你写的，没动） -->
        <model name="wall_a_north">
            <static>true</static>
            <pose>2 4 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>6.0 0.2 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>6.0 0.2 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <!-- A 西墙 -->
        <model name="wall_a_west">
            <static>true</static>
            <pose>-1 2.5 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>0.2 3.0 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>0.2 3.0 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <!-- A 东墙 -->
        <model name="wall_a_east">
            <static>true</static>
            <pose>5 2.5 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>0.2 3.0 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>0.2 3.0 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <!-- A 南墙西段（门口 x∈[1,3] 宽 2m） -->
        <model name="wall_a_south_w">
            <static>true</static>
            <pose>0 1 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>2.0 0.2 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>2.0 0.2 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <!-- A 南墙东段 -->
        <model name="wall_a_south_e">
            <static>true</static>
            <pose>4 1 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>2.0 0.2 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>2.0 0.2 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <!-- ============ 房间 B（南边） y∈[-4,-1] ============ -->
        <!-- B 北墙西段（门口 x∈[1,3]） -->
        <model name="wall_b_north_w">
            <static>true</static>
            <pose>0 -1 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>2.0 0.2 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>2.0 0.2 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <!-- B 北墙东段 -->
        <model name="wall_b_north_e">
            <static>true</static>
            <pose>4 -1 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>2.0 0.2 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>2.0 0.2 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <!-- B 西墙 -->
        <model name="wall_b_west">
            <static>true</static>
            <pose>-1 -2.5 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>0.2 3.0 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>0.2 3.0 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <!-- B 东墙 -->
        <model name="wall_b_east">
            <static>true</static>
            <pose>5 -2.5 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>0.2 3.0 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>0.2 3.0 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <!-- B 南墙（长 6，同 A 北墙） -->
        <model name="wall_b_south">
            <static>true</static>
            <pose>2 -4 0.75 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box><size>6.0 0.2 1.5</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>6.0 0.2 1.5</size></box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>


        <!-- box for lidar testing -->
        <model name="test_box_1">
            <static>true</static>

            <!-- Two metres in front of the robot -->
            <pose>2.0 0.0 0.5 0 0 0</pose>

            <link name="link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.8 0.2 0.2 1</ambient>
                        <diffuse>0.8 0.2 0.2 1</diffuse>
                    </material>
                </visual>

            </link>
        </model>


        <!-- box for lidar testing -->
        <model name="test_box_2">
            <static>true</static>

            <!-- Four metres in front of the robot -->
            <pose>4.0 0.0 0.5 0 0 0</pose>

            <link name="link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.8 0.2 0.2 1</ambient>
                        <diffuse>0.8 0.2 0.2 1</diffuse>
                    </material>
                </visual>

            </link>
        </model>

    </world>

</sdf>